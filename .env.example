# ---------------------------------------------------------------------------
# ScoreAssign API configuration. Copy to apps/api/.env and fill in.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# MongoDB. One cluster; ScoreAssign creates one database per tenant plus a
# shared control-plane database. Do NOT put a database name in the URI --
# it is derived from PLATFORM_DB_NAME / TENANT_DB_PREFIX below.
MONGODB_URI=mongodb://127.0.0.1:27017
PLATFORM_DB_NAME=sa_platform
TENANT_DB_PREFIX=sa_tenant_

# Auth. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Tenant routing. Tenants are addressed as <slug>.APP_ROOT_DOMAIN.
APP_ROOT_DOMAIN=scoreassign.com
WEB_ORIGIN=http://localhost:5173
# Comma-separated extra origins allowed by CORS (local subdomain testing).
EXTRA_CORS_ORIGINS=http://afs.localhost:5173,http://localhost:5173

# Billing. "stub" records intent locally and never contacts a payment
# provider; swap for a real provider by implementing BillingProvider.
BILLING_PROVIDER=stub
ANNUAL_PRICE_CENTS=9600
TRIAL_DAYS=7

# Email. "log" writes rendered messages to stdout instead of sending.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@scoreassign.com
